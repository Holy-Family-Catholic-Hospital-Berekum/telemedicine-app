# Settings for the TEST Firebase project (telemedicine-hfch-test), loaded by
# the Firebase CLI when deploying with `firebase use test`. Not secret.
# The live project has no such file: it uses the defaults in the code.
# See HANDOVER.md, "Test environment".

# No scheduled jobs (no-show checks, reminders, reconciliation, clean-ups):
# keeps the test project free. Their logic is covered by functions/test/.
SCHEDULED_JOBS=off

# The test website has no reCAPTCHA key, so App Check isn't enforced here.
ENFORCE_APP_CHECK=false

# Links in emails sent from the test project.
SITE_URL=https://telemedicine-app-git-test-holy-family-catholic-hospital.vercel.app

# Payment references start HFT- here (live: HFH-). Both projects use
# Paystack's test account until go-live; this way neither one mistakes the
# other's payments for strays and refunds them.
PAYMENT_REF_PREFIX=HFT
