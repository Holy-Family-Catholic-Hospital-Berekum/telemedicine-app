# Settings for the local emulator project used by the automated tests
# (demo-telemedicine: npm run test:functions / test:e2e). Never deployed.
# Not secret. The emulator's dummy secrets are written to .secret.local by
# e2e/run.mjs at test time (git-ignored).

# No scheduled jobs; the tests drive time-based behaviour themselves.
SCHEDULED_JOBS=off
# The emulated website has no reCAPTCHA, so no App Check.
ENFORCE_APP_CHECK=false
# Links in emails point at the local test website.
SITE_URL=http://localhost:4173
# A fake Paystack run by the end-to-end tests (lib/paystack.js; emulator only).
PAYSTACK_API_BASE=http://127.0.0.1:4599
# Emails are queued and marked sent, but never leave the computer
# (lib/mailProvider.js; emulator only).
MAIL_DELIVERY=off
# No video relay credentials from Cloudflare (consultations.js; emulator only).
TURN_RELAY=off
