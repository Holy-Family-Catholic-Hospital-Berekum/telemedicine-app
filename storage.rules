rules_version = '2';

// Cloud Storage Security Rules. Default deny.
//
// recordings/  No client can read, list, overwrite or delete anything. The
//              assigned doctor may only CREATE new segment files for a
//              recording the server opened for them, while it is still
//              "recording". Final files are written by Cloud Functions, and
//              admins play/download them through short-lived signed URLs.
// siteAssets/  Public images; only an active admin may upload.
// doctorProfilePictures/  Public portraits; each doctor writes only their own.
//
// The firestore.get() calls need the Storage service agent to be allowed to
// read Firestore: the Firebase console offers this the first time these
// rules are deployed (accept it).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', ''); }
    function staffActive() {
      return firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.status == 'active';
    }

    match /recordings/{recordingId}/parts/{part} {
      function rec() {
        return firestore.get(/databases/(default)/documents/recordings/$(recordingId)).data;
      }
      allow create: if signedIn()
        && role() == 'doctor'
        && part.matches('^[0-9]{6}[.]webm$')
        && rec().doctorUid == request.auth.uid
        && rec().status == 'recording'
        && request.resource.contentType.matches('video/webm.*')
        && request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    match /siteAssets/{slot}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && role() == 'admin' && staffActive()
        && slot in ['hero', 'auth', 'slider']
        && fileName.matches('^[A-Za-z0-9_.-]+[.]jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if false; // updateSiteImages removes unused files
    }

    match /doctorProfilePictures/{uid}/profile.jpg {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && role() == 'doctor' && staffActive()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid && role() == 'doctor';
    }

    // Everything else, including recordings/{id}/recording.webm: no client access.
  }
}
