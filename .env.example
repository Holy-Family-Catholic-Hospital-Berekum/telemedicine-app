# Copy to `.env` (never commit it) and fill in. The same values (except
# the local-only ones) are set in Vercel → Project → Settings →
# Environment Variables for the live site.
#
# None of these is a secret in the cryptographic sense (the browser sees
# them), but keep them out of the repo anyway. Real secrets (Paystack secret
# key, Resend, Cloudflare) live only in Firebase function secrets; see
# HANDOVER.md.

# Firebase web app config: Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=telemedicine-hfch.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=telemedicine-hfch
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paystack PUBLIC key (pk_test_... until go-live, then pk_live_...).
VITE_PAYSTACK_PUBLIC_KEY=

# The hidden staff sign-in path, e.g. /some-unguessable-path. Ask the
# hospital for it; never write it in the code or link it anywhere.
VITE_STAFF_LOGIN_PATH=

# App Check: the reCAPTCHA Enterprise SITE key (Google Cloud → Security →
# reCAPTCHA). App Check is enforced on the live project, so without this
# (or a debug token below) nothing works.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Public address (canonical links, previews, robots.txt, sitemap.xml).
VITE_SITE_URL=https://telemedicine.hfhberekum.org

# LOCAL ONLY, never in Vercel: an App Check debug token registered in
# Firebase console → App Check → Apps → Manage debug tokens. Lets
# `npm run dev` on localhost pass App Check. Anyone holding it can too:
# delete it in the console when you stop developing.
VITE_APPCHECK_DEBUG_TOKEN=
