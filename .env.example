# Copy to `.env` (never commit it) and fill in with the TEST project's
# values (`firebase apps:sdkconfig WEB --project test`): local development
# never uses the live project. The deployed sites' values are set only in
# GitHub → Settings → Environments (`live`, `test`); see HANDOVER.md
# "Website deploys".
#
# None of these is a secret in the cryptographic sense (the browser sees
# them), but keep them out of the repo anyway. Real secrets (Paystack secret
# key, Brevo, Cloudflare) live only in Firebase function secrets; see
# HANDOVER.md.

# Firebase web app config: Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=telemedicine-hfch-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=telemedicine-hfch-test
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paystack PUBLIC key (pk_test_... until go-live, then pk_live_...).
VITE_PAYSTACK_PUBLIC_KEY=

# The hidden staff sign-in path, e.g. /some-unguessable-path. Ask the
# hospital for it; never write it in the code or link it anywhere.
VITE_STAFF_LOGIN_PATH=

# App Check: the reCAPTCHA Enterprise SITE key (Google Cloud → Security →
# reCAPTCHA). App Check is enforced on both projects, so without this
# (or a debug token below) nothing works.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Public address (canonical links, previews, robots.txt, sitemap.xml).
VITE_SITE_URL=https://telemedicine.hfhberekum.org

# Set by the deploy workflow, not here: VITE_SEARCH_INDEXING (`off` on the
# test site: robots.txt and every page noindex) and VITE_CANONICAL_REDIRECT
# (`on` in the GitHub `live` environment: *.web.app / *.firebaseapp.com
# visitors are sent to VITE_SITE_URL). Leave both unset locally.

# LOCAL ONLY, never in GitHub: an App Check debug token registered in the
# TEST project (Firebase console → App Check → Apps → Manage debug tokens;
# the live project has none and must keep it that way). Lets
# `npm run dev` on localhost pass App Check. Anyone holding it can too:
# delete it in the console when you stop developing.
VITE_APPCHECK_DEBUG_TOKEN=
